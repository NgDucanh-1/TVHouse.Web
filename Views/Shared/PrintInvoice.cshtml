@* TRANG IN HÓA ĐƠN (không dùng khung chung): thông tin khách, nhân viên tư vấn, phương thức thanh toán, danh sách hàng, giảm giá, tổng tiền. Tự mở hộp thoại in khi tải xong. *@
@model Invoice
@{
    Layout = null;
    var order = Model.Order;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <title>Hóa đơn @Model.InvoiceCode</title>
    <style>
        body { font: 14px Arial, sans-serif; padding: 35px; color: #172033; max-width: 820px; margin: 0 auto; }
        h1, h2 { text-align: center; margin: 4px 0; }
        table { width: 100%; border-collapse: collapse; margin-top: 25px; }
        td, th { border: 1px solid #aaa; padding: 10px; text-align: left; }
        .num { text-align: right; }
        .meta { margin-top: 22px; line-height: 1.8; display: grid; grid-template-columns: 1fr 1fr; gap: 0 30px; }
        .sum { margin-top: 20px; margin-left: auto; width: 320px; line-height: 2; }
        .sum div { display: flex; justify-content: space-between; }
        .sum .total { font-size: 19px; font-weight: bold; border-top: 1px solid #555; margin-top: 4px; padding-top: 4px; }
        .sum .disc { color: #15803d; }
        .sign { display: flex; justify-content: space-between; margin-top: 50px; text-align: center; }
        .sign div { width: 40%; }
        .toolbar-print { text-align: center; margin-bottom: 18px; }
        .toolbar-print button, .toolbar-print a { font: 13px Arial; padding: 8px 16px; margin: 0 4px; cursor: pointer; border: 1px solid #1d4ed8; background: #1d4ed8; color: #fff; border-radius: 6px; text-decoration: none; }
        .toolbar-print a { background: #fff; color: #1d4ed8; }
        .noprint-hint { text-align: center; font-size: 12px; color: #667085; }
    </style>
    <style media="print">
        .toolbar-print, .noprint-hint { display: none; }
    </style>
</head>
<body>
    <div class="toolbar-print">
        <button type="button" onclick="window.print()">In hóa đơn</button>
        <a href="/">Về cửa hàng</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/Admin/Invoices">Danh sách hóa đơn</a>
        }
    </div>

    <h1>TV HOUSE</h1>
    <h2>HÓA ĐƠN BÁN HÀNG</h2>

    <div class="meta">
        <div>Mã hóa đơn: <b>@Model.InvoiceCode</b></div>
        <div>Ngày xuất: @Model.InvoiceDate.ToString("dd/MM/yyyy HH:mm")</div>
        <div>Khách hàng: <b>@order.CustomerName</b></div>
        <div>Mã đơn: @order.OrderCode</div>
        <div>Điện thoại: @(order.Customer?.Phone ?? "—")</div>
        <div>Thanh toán: <b>@order.PaymentMethod</b></div>
        <div>Email: @(order.Customer?.Email ?? "—")</div>
        <div>Nhân viên tư vấn: <b>@order.EmployeeName</b></div>
    </div>

    <table>
        <thead>
            <tr><th>Sản phẩm</th><th class="num">Đơn giá</th><th class="num">SL</th><th class="num">Thành tiền</th></tr>
        </thead>
        <tbody>
        @foreach (var item in order.Items)
        {
            <tr>
                <td>@item.Product.Name<br><small>@item.Product.Model</small></td>
                <td class="num">@Fmt.Money(item.UnitPrice)</td>
                <td class="num">@item.Quantity</td>
                <td class="num">@Fmt.Money(item.UnitPrice * item.Quantity)</td>
            </tr>
        }
        </tbody>
    </table>

    <div class="sum">
        <div><span>Tạm tính</span><span>@Fmt.Money(order.SubtotalAmount)</span></div>
        @if (order.DiscountAmount > 0)
        {
            <div class="disc"><span>Mã giảm giá @(order.DiscountCode?.Code) (-@(order.DiscountCode?.DiscountPercent)%)</span><span>- @Fmt.Money(order.DiscountAmount)</span></div>
        }
        <div class="total"><span>Tổng thanh toán</span><span>@Fmt.Money(Model.TotalAmount)</span></div>
    </div>

    <div class="sign">
        <div>Khách hàng<br><small>(Ký, ghi rõ họ tên)</small><br><br><br>@order.CustomerName</div>
        <div>Nhân viên bán hàng<br><small>(Ký, ghi rõ họ tên)</small><br><br><br>@order.EmployeeName</div>
    </div>

    <p class="noprint-hint">Cảm ơn quý khách đã mua hàng tại TV House.</p>
    <script>window.addEventListener('load', function () { window.print(); });</script>
</body>
</html>
