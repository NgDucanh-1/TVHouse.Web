@* Trang đổi mật khẩu của tài khoản đang đăng nhập *@
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<main>
    <div class="panel login-box">
        <div class="panel-head"><h2>Đổi mật khẩu</h2></div>
        <form method="post" asp-action="ChangePassword">
            <div class="form-grid">
                <label class="full">Mật khẩu hiện tại
                    <input class="field" asp-for="CurrentPassword" type="password" autocomplete="current-password" />
                    <span class="field-error" asp-validation-for="CurrentPassword"></span>
                </label>
                <label class="full">Mật khẩu mới (tối thiểu 8 ký tự)
                    <input class="field" asp-for="NewPassword" type="password" autocomplete="new-password" />
                    <span class="field-error" asp-validation-for="NewPassword"></span>
                </label>
                <label class="full">Nhập lại mật khẩu mới
                    <input class="field" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span class="field-error" asp-validation-for="ConfirmPassword"></span>
                </label>
            </div>
            <div class="form-actions">
                <button type="submit" class="admin-btn">Lưu mật khẩu mới</button>
                <a class="secondary-btn" asp-controller="Admin" asp-action="Index">Hủy</a>
            </div>
        </form>
    </div>
</main>
