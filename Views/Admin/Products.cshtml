@* QUẢN TRỊ - DANH SÁCH SẢN PHẨM: tìm kiếm, ảnh nhỏ, nút Sửa/Xóa. *@
@model List<Product>
@{
    ViewData["Title"] = "Quản trị — Sản phẩm";
    ViewData["Section"] = "products";
    var q = ViewData["Q"] as string;
}
<div class="panel">
    <div class="panel-head">
        <h2>Danh sách sản phẩm</h2>
        <a class="admin-btn" asp-action="ProductCreate">+ Thêm sản phẩm</a>
    </div>
    <form class="search-row" method="get" asp-action="Products">
        <input class="field" name="q" value="@q" placeholder="Tìm sản phẩm..." />
        <button type="submit" class="secondary-btn">Tìm</button>
        <span class="hint">@Model.Count sản phẩm</span>
    </form>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Mã SP</th><th>Tên sản phẩm</th><th>Thương hiệu</th><th>Giá bán</th><th>Tồn kho</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@Fmt.ProductCode(p.Id)</td>
                    <td>
                        @if (p.MainImageId.HasValue)
                        {
                            <img class="thumb" src="@Fmt.Image(p.MainImageId)" alt="" />
                        }
                        else
                        {
                            <span class="thumb thumb-empty">📺</span>
                        }
                        <span class="thumb-text"><b>@p.Name</b><br><small>@p.Model</small></span>
                    </td>
                    <td>@p.Brand</td>
                    <td>@Fmt.Money(p.Price)</td>
                    <td>@p.Stock</td>
                    <td>
                        <a class="action-btn" asp-action="ProductEdit" asp-route-id="@p.Id">Sửa</a>
                        <form class="inline" method="post" asp-action="ProductDelete" asp-route-id="@p.Id" data-confirm="Bạn có chắc muốn xóa sản phẩm này?">
                            <button type="submit" class="action-btn">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6">Không tìm thấy sản phẩm.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
