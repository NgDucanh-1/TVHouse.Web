@* QUẢN TRỊ - KHO HÀNG: chỉ xem tồn kho và tìm theo tên hàng. *@
@model List<Product>
@{
    ViewData["Title"] = "Quản trị — Kho hàng";
    ViewData["Section"] = "inventory";
    var q = ViewData["Q"] as string;
}
<div class="panel">
    <div class="panel-head"><h2>Tồn kho</h2><span>Chỉ xem — số lượng thay đổi qua phiếu nhập và hóa đơn</span></div>
    <form class="search-row" method="get" asp-action="Inventory">
        <input class="field" name="q" value="@q" placeholder="Tìm theo tên hàng..." />
        <button type="submit" class="secondary-btn">Tìm</button>
        @if (!string.IsNullOrEmpty(q))
        {
            <a class="secondary-btn" asp-action="Inventory">Xóa lọc</a>
        }
        <span class="hint">@Model.Count mặt hàng</span>
    </form>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Mã SP</th><th>Tên hàng</th><th>Thương hiệu</th><th class="num">Tồn kho</th><th>Tình trạng</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@Fmt.ProductCode(p.Id)</td>
                    <td>
                        @if (p.MainImageId.HasValue)
                        {
                            <img class="thumb" src="@Fmt.Image(p.MainImageId)" alt="" />
                        }
                        else
                        {
                            <span class="thumb thumb-empty">📺</span>
                        }
                        <span class="thumb-text"><b>@p.Name</b><br><small>@p.Model</small></span>
                    </td>
                    <td>@p.Brand</td>
                    <td class="num"><b>@p.Stock</b></td>
                    <td>
                        @if (p.Stock == 0) { <span class="status bad">Hết hàng</span> }
                        else if (p.Stock <= 5) { <span class="status bad">Sắp hết</span> }
                        else { <span class="status good">Đủ hàng</span> }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5">Không tìm thấy mặt hàng.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
