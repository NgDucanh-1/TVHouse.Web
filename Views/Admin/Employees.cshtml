@* QUẢN TRỊ - NHÂN VIÊN BÁN HÀNG: danh sách kèm số hóa đơn và doanh thu tư vấn. *@
@model List<EmployeeRow>
@{
    ViewData["Title"] = "Quản trị — Nhân viên";
    ViewData["Section"] = "employees";
}
<div class="panel">
    <div class="panel-head">
        <h2>Nhân viên bán hàng</h2>
        <a class="admin-btn" asp-action="EmployeeCreate">+ Thêm nhân viên</a>
    </div>
    <p class="hint" style="margin:0 0 12px">Nhân viên được chọn ở bước xuất hóa đơn để biết ai đã tư vấn cho khách. Doanh thu chỉ tính hóa đơn của đơn đã hoàn thành.</p>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Mã NV</th><th>Họ tên</th><th>Chức vụ</th><th>Điện thoại</th><th>Email</th><th>Ngày vào làm</th><th class="num">Số hóa đơn</th><th class="num">Doanh thu tư vấn</th><th>Thao tác</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Employee.EmployeeCode</td>
                    <td><b>@r.Employee.FullName</b></td>
                    <td>@r.Employee.Position</td>
                    <td>@r.Employee.Phone</td>
                    <td>@r.Employee.Email</td>
                    <td>@Fmt.Date(r.Employee.HireDate)</td>
                    <td class="num">@r.InvoiceCount</td>
                    <td class="num">@Fmt.Money(r.Revenue)</td>
                    <td>
                        <a class="action-btn" asp-action="EmployeeEdit" asp-route-id="@r.Employee.Id">Sửa</a>
                        <form class="inline" method="post" asp-action="EmployeeDelete" asp-route-id="@r.Employee.Id" data-confirm="Cho nhân viên này nghỉ việc? (các hóa đơn cũ vẫn giữ tên nhân viên)">
                            <button type="submit" class="action-btn">Nghỉ việc</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="9">Chưa có nhân viên.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
