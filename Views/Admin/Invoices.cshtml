@* QUẢN TRỊ - DANH SÁCH HÓA ĐƠN: khách, nhân viên tư vấn, thanh toán, mã giảm giá, nút in. *@
@model List<Invoice>
@{
    ViewData["Title"] = "Quản trị — Hóa đơn";
    ViewData["Section"] = "invoices";
}
<div class="panel">
    <div class="panel-head"><h2>Hóa đơn bán hàng</h2><span>Xuất từ giỏ hàng hoặc khi đơn chuyển sang “Hoàn thành”</span></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Mã HĐ</th><th>Mã đơn</th><th>Ngày</th><th>Khách hàng</th><th>NV tư vấn</th><th>Thanh toán</th><th>Mã giảm giá</th><th class="num">Tổng tiền</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>#@x.InvoiceCode</td>
                    <td>#@x.Order.OrderCode</td>
                    <td>@Fmt.Date(x.InvoiceDate)</td>
                    <td>@x.Order.CustomerName</td>
                    <td>@x.Order.EmployeeName</td>
                    <td>@x.Order.PaymentMethod</td>
                    <td>
                        @if (x.Order.DiscountCode != null)
                        {
                            <span class="status good">@x.Order.DiscountCode.Code</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td class="num">@Fmt.Money(x.TotalAmount)</td>
                    <td><a class="action-btn primary" target="_blank" asp-action="PrintInvoice" asp-route-id="@x.Id">In hóa đơn</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="9">Chưa có hóa đơn bán hàng.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
