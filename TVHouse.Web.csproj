<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TVHouse.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- File SQL được đọc lúc chạy để xuất dữ liệu ra file .sql, nên phải copy khi publish -->
    <Content Include="Database\*.sql" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
  </ItemGroup>

</Project>
